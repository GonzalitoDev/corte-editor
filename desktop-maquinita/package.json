{
  "name": "maquinita",
  "productName": "La Maquinita",
  "version": "1.0.0",
  "description": "Juego de clics satírico: imprimí billetes, esquivá la inflación y sobreviví a las elecciones",
  "author": { "name": "GonzalitoDev", "email": "gonzalitodev@users.noreply.github.com" },
  "license": "MIT",
  "homepage": "https://github.com/GonzalitoDev/corte-editor",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node prepare.js && electron .",
    "dist:win": "node prepare.js && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "node prepare.js && electron-builder --linux deb AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "dev.gonzalito.maquinita",
    "productName": "La Maquinita",
    "copyright": "GonzalitoDev",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "autoupdate.js", "clave-publica.pem", "app/**/*", "build/icon.png"],
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "La Maquinita",
      "installerLanguages": ["es_ES"],
      "language": "3082",
      "artifactName": "LaMaquinita-Setup.${ext}"
    },
    "linux": {
      "target": ["deb", "AppImage"],
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "maquinita",
      "synopsis": "Juego de clics satírico sobre imprimir billetes",
      "description": "La Maquinita: imprimí billetes, esquivá la inflación, contratá ñoquis y sobreviví a las elecciones.",
      "desktop": { "Name": "La Maquinita", "Comment": "Juego de clics satírico", "Keywords": "juego;clics;game;idle;" }
    },
    "deb": { "artifactName": "LaMaquinita.${ext}", "packageCategory": "games", "priority": "optional" },
    "appImage": { "artifactName": "LaMaquinita.${ext}" }
  },
  "repository": { "type": "git", "url": "https://github.com/GonzalitoDev/corte-editor.git" }
}
